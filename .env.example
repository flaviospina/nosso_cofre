# ============================================================
# Nosso Cofre — configuração (copie para .env e preencha)
# NUNCA envie este arquivo preenchido para o repositório.
# Valores aleatórios (APP_KEY, CRON_TOKEN, BACKUP_KEY) podem ser
# gerados pela tela /instalar enquanto o APP_KEY estiver vazio.
# ============================================================

# --- Aplicação ---
APP_NAME="Nosso Cofre"
# production | development
APP_ENV=production
# true mostra erros detalhados na tela. Em produção SEMPRE false.
APP_DEBUG=false
# URL pública completa, sem barra no final (subpasta incluída)
APP_URL=https://itthrive.com.br/cofre
# Chave de 32 bytes em base64 (criptografia de campos sensíveis e assinaturas). Gere em /instalar.
APP_KEY=
# Fuso horário padrão para novos usuários
APP_TIMEZONE=America/Sao_Paulo

# --- Banco de dados (cPanel → MySQL Databases) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=usuario_cofre
DB_USER=usuario_cofre
DB_PASS=

# --- E-mail (cPanel → Contas de e-mail) ---
# smtp (produção) | log (desenvolvimento: grava em storage/logs/mail-*.log em vez de enviar)
MAIL_DRIVER=smtp
MAIL_HOST=mail.itthrive.com.br
MAIL_PORT=465
# ssl (porta 465) | tls (porta 587)
MAIL_ENCRYPTION=ssl
MAIL_USER=cofre@itthrive.com.br
MAIL_PASS=
MAIL_FROM_ADDRESS=cofre@itthrive.com.br
MAIL_FROM_NAME="Nosso Cofre"

# --- Segurança ---
# database (permite a tela "Sessões ativas") | files
SESSION_DRIVER=database
# Minutos de inatividade até expirar a sessão (o usuário pode escolher 15/30/60 na conta)
SESSION_IDLE_MINUTES=30
# Horas de duração máxima de uma sessão, mesmo em uso
SESSION_ABSOLUTE_HOURS=12
# Dias de validade do "lembrar-me"
REMEMBER_DAYS=30
# Se o site estiver atrás de Cloudflare/proxy, informe os IPs confiáveis separados por vírgula (senão deixe vazio)
TRUSTED_PROXIES=

# --- Cron (cPanel → Cron Jobs) ---
# Token exigido quando o cron é chamado por URL. Gere em /instalar.
CRON_TOKEN=

# --- Backup criptografado (AES-256-GCM) ---
# Chave de 32 bytes em base64, DIFERENTE do APP_KEY. Guarde uma cópia fora do servidor.
BACKUP_KEY=
BACKUP_RETENTION_DAYS=30

# --- Web Push (VAPID) — preenchido na fase de notificações pela tela protegida ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:cofre@itthrive.com.br

# --- Área do controlador (incidentes LGPD): e-mails de usuários com acesso, separados por vírgula ---
ADMIN_EMAILS=prof.flavio.spina@gmail.com

# --- LGPD: controlador e encarregado (DPO) — exibidos na Política de Privacidade ---
CONTROLLER_NAME="Flávio Spina"
# CPF (pessoa física) ou CNPJ. Exibido parcialmente mascarado na política.
CONTROLLER_DOCUMENT=
CONTROLLER_EMAIL=cofre@itthrive.com.br
DPO_NAME="Flávio Spina"
DPO_EMAIL=cofre@itthrive.com.br

# --- Logs ---
# debug | info | warning | error
LOG_LEVEL=info
LOG_RETENTION_DAYS=30
